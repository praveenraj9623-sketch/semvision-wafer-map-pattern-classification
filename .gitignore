# ── Raw & processed data (gitignored — user provides LSWMD.pkl) ──────────────
data/raw/
data/processed/

# ── Trained model artifacts (generated by run_training.py) ──────────────────
artifacts/mlruns/

# ── Demo data: EXCLUDE all pkl files in data/ EXCEPT demo_samples.pkl ────────
data/**/*.pkl
!data/demo/demo_samples.pkl

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
*.pyo

# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.*
venv/
.venv/
env/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test cache ────────────────────────────────────────────────────────────────
.pytest_cache/
